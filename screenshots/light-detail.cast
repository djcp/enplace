[0.006763, "o", "\u001b[H                                                                                                                                                              \u001b[K\r\n  \u001b[38;5;167m\u001b[1m🍳  enplace  \u001b(B\u001b[m\u001b[38;5;244m\u001b[1m/\u001b(B\u001b[m  \u001b[38;5;239mInstant Pot Brown Rice\u001b[39m                                                                    \u001b[38;5;244m🔍 / search\u001b[39m   \u001b[38;5;244m⚙ m manage\u001b[39m   \u001b[38;5;244m🏠 h home\u001b[39m   \u001b[38;5;244m🚪 q quit\u001b[39m  \u001b[K\r\n                                                                                                                                                              \u001b[K\u001b[38;5;188m\r\n──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[K\r\n\u001b[K\u001b[38;5;167m\u001b[1m\r\nInstant Pot Brown Rice\u001b(B\u001b[m                                                                              \u001b[K\u001b[38;5;244m\r\nPrep 5m  ·  Cook 50m  ·  Serves 8 servings\u001b[39m\u001b[K\u001b[48;5;167m\r\n \u001b[38;5;231mside dish\u001b[39m \u001b[49m \u001b[48;5;107m \u001b[38;5;231mpressure cook\u001b[39m \u001b[49m \u001b[48;5;66m \u001b[38;5;231mgluten-free\u001b[39m \u001b[49m \u001b[48;5;66m \u001b[38;5;231mvegan\u001b[39m \u001b[49m \u001b[48;5;66m \u001b[38;5;231mvegetarian\u001b[39m \u001b[49m \u001b[K\r\n\u001b[K\u001b[38;5;239m\u001b[7m\r\nLearn how to cook brown rice in the Instant Pot. The process is easy and hands-off, and the rice\u001b(B\u001b[m    \u001b[K\u001b[38;5;239m\u001b[7m\r\ncomes out perfect every time.\u001b(B\u001b[m                                                                       \u001b[K\r\n\u001b[K\r\n           \u001b[K\u001b[38;5;107m\u001b[1m\r\nIngredients\u001b(B\u001b[m\u001b[K\u001b[38;5;244m\r\n  · \u001b[39m2 cup brown rice, uncooked, well-rinsed\u001b[K\u001b[38;5;244m\r\n  · \u001b[39m2.5 cup water\u001b[K\r\n\u001b[K\r\n          \u001b[K\u001b[38;5;107m\u001b[1m\r\nDirections\u001b(B\u001b[m\u001b[K\r\n\u001b[K\r\n  \u001b[38;5;234m                                                                                                \u001b[39m\u001b[K\r\n  \u001b[38;5;234m1. Combine the rinsed brown rice and water in a 6-quart Instant Pot. Secure the lid and Pressure\u001b[39m\u001b[K\r\n  \u001b[38;5;234mCook on High for 20 minutes.                                                                    \u001b[39m\u001b[K\r\n  \u001b[38;5;234m2. Allow the Instant Pot to release pressure naturally. This will take 20 to 30 minutes. When   \u001b[39m\u001b[K\r\n  \u001b[38;5;234mthe float valve drops, remove the lid.                                                          \u001b[39m\u001b[K\r\n  \u001b[38;5;234m3. Fluff the rice and enjoy.                                                                    \u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[38;5;244m\r\nSource: https://www.loveandlemons.com/instant-pot-brown-rice/#wprm-recipe-container-61578\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[38;5;188m\r\n──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[K\u001b[38;5;244m\r\n  📜 ↑/↓ scroll   🏠 h home\u001b[39m   \u001b[38;5;244m✏️ e edit\u001b[39m   \u001b[38;5;244m⚖ s scale\u001b[39m   \u001b[38;5;244m💾 p export\u001b[39m   \u001b[38;5;244m➕ a add\u001b[39m   \u001b[38;5;244m🗑 d delete\u001b[39m   \u001b[38;5;244m★ r rate\u001b[39m   \u001b[38;5;244m📝 N notes\u001b[39m                          \u001b[38;5;145menplace 1.2.0-alpha\u001b[39m\u001b[K\r\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[1;1H\u001b[1;45r\u001b[45;1H\u001b[?25l\u001b[H                                                                                                                                                              \u001b[K\r\n  \u001b[38;5;167m\u001b[1m🍳  enplace  \u001b(B\u001b[m\u001b[38;5;244m\u001b[1m/\u001b(B\u001b[m  \u001b[38;5;239mInstant Pot Brown Rice\u001b[39m    "]
